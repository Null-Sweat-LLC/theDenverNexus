{
  "name": "test2doc-maestro-demo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "expo": "54.0.37",
    "expo-build-properties": "1.0.10",
    "expo-constants": "18.0.14",
    "expo-device": "8.0.10",
    "expo-font": "14.0.12",
    "expo-glass-effect": "0.1.10",
    "expo-image": "3.0.11",
    "expo-linking": "8.0.12",
    "expo-router": "6.0.24",
    "expo-splash-screen": "31.0.13",
    "expo-status-bar": "3.0.9",
    "expo-symbols": "1.0.8",
    "expo-system-ui": "6.0.9",
    "expo-web-browser": "15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "typescript": "~5.9.3"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@expo/dom-webview"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome lint src",
    "e2e:native": "maestro test --include-tags=native .maestro",
    "e2e:web": "maestro test --include-tags=web .maestro",
    "typecheck": "tsc --noEmit",
    "e2e:docs": "rm -rf maestro-output && maestro test -e TEST2DOC=true --include-tags=native --test-output-dir maestro-output .maestro"
  },
  "private": true
}
