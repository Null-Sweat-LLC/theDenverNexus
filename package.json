{
  "name": "the-denver-nexus",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:test2doc": "cd packages/test2doc-playwright && pnpm clean && pnpm build",
    "publish:test2doc": "cd packages/test2doc-playwright && pnpm publish  --provenance --access public",
    "test:barefeed": "cd apps/barefeed && pnpm test:ci",
    "test:test2doc": "cd packages/test2doc-playwright && pnpm test",
    "test:maestro": "cd packages/test2doc-maestro && pnpm test",
    "format": "biome format --write .",
    "docker:ci:build": "docker build -f Dockerfile.ci -t test2doc-ci .",
    "docker:ci:test": "docker-compose -f docker-compose.ci.yml run --rm playwright-ci",
    "docker:ci:shell": "docker-compose -f docker-compose.ci.yml run --rm playwright-ci bash",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "14.0.0-beta.4",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "15.0.0-beta.3",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@semantic-release/exec": "^7.1.0"
  }
}
