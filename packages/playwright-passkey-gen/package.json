{
  "name": "@test2doc/playwright-passkey-gen",
  "version": "1.0.0",
  "description": "A utility to generate test passkey credentials for WebAuthn testing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Null-Sweat-LLC/theDenverNexus.git",
    "directory": "packages/playwright-passkey-gen"
  },
  "main": "dist/src/generate-passkey/index.js",
  "module": "dist/src/generate-passkey/index.js",
  "types": "dist/src/generate-passkey/index.d.ts",
  "scripts": {
    "start": "node ./dist/src/scripts/server.js",
    "dev": "pnpm build:watch & node --watch ./dist/src/scripts/server.js",
    "pretest": "pnpm playwright install --with-deps chromium firefox webkit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "unit": "vitest",
    "ci:unit": "vitest run",
    "ci:test": "pnpm build && pnpm ci:unit && pnpm test",
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "clean": "rm -rf dist && rm -rf tsconfig.tsbuildinfo",
    "format": "biome format --write .",
    "lint": "biome lint . --fix",
    "passkey-gen": "pnpm build && node ./bin/generate-passkey"
  },
  "bin": {
    "playwright-passkey-gen": "./bin/generate-passkey"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "keywords": [
    "passkey",
    "playwright",
    "utility",
    "WebAuthn",
    "generator"
  ],
  "author": "Null Sweat, LLC",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@simplewebauthn/server": "^14.0.3",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "commander": "^14.0.3"
  }
}
